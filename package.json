{
  "name": "shibboleth-sp",
  "version": "1.1.0",
  "description": "A nodejs typescript library that provides all service provider functionality for authenticating with a shibboleth IDP",
  "repository": {
    "type": "git",
    "url": "https://github.com/whennemuth/shibboleth-sp.git"
  },
  "scripts": {
    "build": "node src/build.js",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run build",
    "pack": "npm pack --pack-destination .",
    "release": "npm publish",
    "watch": "tsc -w --noEmit",
    "test": "jest --silent",
    "prepublishOnly": "npm test && npx attw --pack .",
    "publish-s3": "bash bin/publish.sh s3",
    "publish-npm": "bash bin/publish.sh npm"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false,
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.mjs",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/types/index.d.mts",
        "default": "./dist/esm/index.mjs"
      },
      "require": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@types/saml2-js": "^3.0.4",
    "@xmldom/xmldom": "^0.8.15",
    "jsonwebtoken": "^9.0.3",
    "ms": "^2.1.3",
    "node-forge": "^1.4.2"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@jest/globals": "^30.5.2",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/ms": "^2.1.0",
    "@types/node": "^22.20.5",
    "@types/node-forge": "^1.3.14",
    "dts-bundle-generator": "^9.5.1",
    "esbuild": "^0.28.2",
    "jest": "^30.5.2",
    "saml2-js": "^4.0.4",
    "ts-jest": "^29.4.15",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "js-yaml": "^3.15.2",
    "underscore": "^1.13.8"
  }
}
